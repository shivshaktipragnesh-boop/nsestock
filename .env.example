# From developers.kite.trade > your app
KITE_API_KEY=
KITE_API_SECRET=

# Recommended: your Zerodha client ID, so only your account can complete the login
KITE_USER_ID=

# Recommended: any long random string. The app and login URL then require ?key=<this>
APP_KEY=

# Upstash Redis (Vercel Marketplace adds these automatically; KV_REST_API_URL / KV_REST_API_TOKEN also work)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
